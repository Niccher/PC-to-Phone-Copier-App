<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/_4sdp"
        app:cardCornerRadius="@dimen/_6sdp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/all_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/_4sdp">

            <TextView
                android:id="@+id/f_info_ext"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_40sdp"
                android:background="@color/col_bg_lite_gray"
                android:gravity="center"
                android:text="@string/app_name_1"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/f_info_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_6sdp"
                android:ellipsize="end"
                android:text="@string/app_name_1"
                android:textSize="@dimen/_14sdp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/f_info_ext"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/f_info_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:text="@string/app_name_1"
                android:textSize="@dimen/_10sdp"
                android:textStyle="italic"
                app:layout_constraintStart_toEndOf="@id/f_info_ext"
                app:layout_constraintTop_toBottomOf="@id/f_info_name" />

            <TextView
                android:id="@+id/f_info_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:text="@string/app_name_1"
                android:textSize="@dimen/_10sdp"
                android:textStyle="italic"
                app:layout_constraintStart_toEndOf="@id/f_info_ext"
                app:layout_constraintTop_toBottomOf="@id/f_info_type" />

            <TextView
                android:id="@+id/f_info_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:ellipsize="end"
                android:text="@string/app_name_1"
                android:textSize="@dimen/_10sdp"
                android:textStyle="italic"
                app:layout_constraintStart_toEndOf="@id/f_info_ext"
                app:layout_constraintTop_toBottomOf="@id/f_info_size" />

            <TextView
                android:id="@+id/f_info_download"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:drawableStart="@drawable/ic_download"
                android:padding="@dimen/_2sdp"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/f_info_delete" />

            <TextView
                android:id="@+id/f_info_delete"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:drawableStart="@drawable/ic_delete"
                android:padding="@dimen/_2sdp"
                android:paddingStart="@dimen/_8sdp"
                android:paddingEnd="@dimen/_8sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ProgressBar
                android:id="@+id/f_info_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_2sdp"
                android:layout_marginEnd="@dimen/_6sdp"
                android:indeterminate="true"
                android:max="100"
                app:layout_constraintEnd_toStartOf="@id/f_info_download"
                app:layout_constraintStart_toEndOf="@id/f_info_ext"
                app:layout_constraintTop_toBottomOf="@id/f_info_date" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</layout>
<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/_8sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_6sdp"
        app:cardCornerRadius="@dimen/_12sdp"
        app:strokeColor="@color/col_bg_dark_gray"
        app:strokeWidth="1dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/col_bg_lite_gray">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/all_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_8sdp">

            <!-- Extension Badge — anchored to top only -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ext_badge"
                android:layout_width="@dimen/_48sdp"
                android:layout_height="@dimen/_48sdp"
                app:cardCornerRadius="@dimen/_8sdp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/f_info_ext"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="?"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_11sdp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

            <!-- File Name -->
            <TextView
                android:id="@+id/f_info_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginEnd="@dimen/_4sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dull_primary"
                android:textSize="@dimen/_13sdp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/card_ext_badge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/card_ext_badge" />

            <!-- MIME type -->
            <TextView
                android:id="@+id/f_info_type"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/dull_secondary"
                android:textSize="@dimen/_10sdp"
                android:textStyle="italic"
                app:layout_constraintStart_toEndOf="@id/card_ext_badge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/f_info_name" />

            <!-- File Size -->
            <TextView
                android:id="@+id/f_info_size"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/_10sdp"
                android:textStyle="bold"
                app:layout_constraintStart_toEndOf="@id/card_ext_badge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/f_info_type" />

            <!-- Date -->
            <TextView
                android:id="@+id/f_info_date"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_4sdp"
                android:textColor="@color/dull_secondary"
                android:textSize="@dimen/_9sdp"
                app:layout_constraintStart_toEndOf="@id/card_ext_badge"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/f_info_size" />

            <!-- Row 2: Download | Delete | Checkbox — all on the same baseline -->
            <TextView
                android:id="@+id/f_info_download"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_download"
                android:gravity="center"
                android:padding="@dimen/_4sdp"
                android:textColor="@color/dull_success"
                app:layout_constraintTop_toBottomOf="@id/f_info_date"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/card_ext_badge"
                app:layout_constraintEnd_toStartOf="@id/f_info_delete" />

            <TextView
                android:id="@+id/f_info_delete"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:background="?android:attr/selectableItemBackground"
                android:drawableStart="@drawable/ic_delete"
                android:gravity="center"
                android:padding="@dimen/_4sdp"
                android:textColor="@color/dull_error"
                app:layout_constraintTop_toBottomOf="@id/f_info_date"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/f_info_download"
                app:layout_constraintEnd_toStartOf="@id/f_info_checkbox" />

            <CheckBox
                android:id="@+id/f_info_checkbox"
                android:layout_width="0dp"
                android:layout_height="@dimen/_32sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:buttonTint="@color/colorPrimary"
                android:gravity="center"
                android:layout_gravity="center"
                app:layout_constraintTop_toBottomOf="@id/f_info_date"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@id/f_info_delete"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Progress bar (shown when downloading/deleting) -->
            <ProgressBar
                android:id="@+id/f_info_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/_4sdp"
                android:indeterminate="true"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@id/f_info_download"
                app:layout_constraintEnd_toStartOf="@id/f_info_checkbox"
                app:layout_constraintStart_toEndOf="@id/card_ext_badge" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</layout>
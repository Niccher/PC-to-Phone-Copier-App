<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorSurface"
    android:fitsSystemWindows="true">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/_24sdp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="@dimen/_28sdp">

                <androidx.cardview.widget.CardView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:layout_marginBottom="@dimen/_16sdp"
                    app:cardCornerRadius="44dp"
                    app:cardElevation="6dp"
                    app:cardBackgroundColor="@color/colorPrimaryLight">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:background="@color/colorPrimary">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@mipmap/app_logo"
                            android:scaleType="fitCenter"
                            app:tint="@android:color/white"/>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/reg_brand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Connect to PC"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="@dimen/_22sdp"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/_6sdp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Choose your preferred pairing method to connect your phone and desktop browser"
                    android:textColor="@color/dull_secondary"
                    android:textSize="@dimen/_13sdp"
                    android:lineSpacingExtra="2dp"/>

            </LinearLayout>

            <!-- QR Method Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/col_bg_dark_gray"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/col_bg_lite_gray"
                android:layout_marginBottom="@dimen/_20sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_18sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/_10sdp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:cardCornerRadius="22dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardElevation="2dp"
                            android:layout_marginEnd="@dimen/_12sdp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@mipmap/img_qr"
                                app:tint="@color/colorPrimaryDark"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="QR Code Scanner"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/_15sdp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/reg_brand_head"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_auth_qr_scan"
                        android:textColor="@color/dull_primary"
                        android:textSize="@dimen/_12sdp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="@dimen/_16sdp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_auth_scan_qr"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Scan QR Code"
                        android:textAllCaps="false"
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/colorPrimary"
                        app:cornerRadius="@dimen/_14sdp"
                        app:elevation="4dp"
                        app:icon="@mipmap/img_qr"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/_8sdp"
                        app:iconTint="@android:color/white"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Code Method Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_16sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/col_bg_dark_gray"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/col_bg_lite_gray"
                android:layout_marginBottom="@dimen/_20sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/_18sdp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="@dimen/_10sdp">

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            app:cardCornerRadius="22dp"
                            app:cardBackgroundColor="@color/white"
                            app:cardElevation="2dp"
                            android:layout_marginEnd="@dimen/_12sdp">

                            <ImageView
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_lock_lock"
                                app:tint="@color/colorPrimaryDark"/>
                        </com.google.android.material.card.MaterialCardView>

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Manual 6-Digit Code"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/_15sdp"
                            android:textStyle="bold"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/reg_previous_session"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/txt_auth_code_scan"
                        android:textColor="@color/dull_primary"
                        android:textSize="@dimen/_12sdp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginBottom="@dimen/_14sdp"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Enter 6-digit code from PC browser"
                        app:hintTextColor="@color/dull_secondary"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/colorPrimary"
                        app:endIconMode="clear_text"
                        app:endIconTint="@color/dull_secondary"
                        app:boxCornerRadiusTopStart="@dimen/_12sdp"
                        app:boxCornerRadiusTopEnd="@dimen/_12sdp"
                        app:boxCornerRadiusBottomEnd="@dimen/_12sdp"
                        app:boxCornerRadiusBottomStart="@dimen/_12sdp"
                        android:layout_marginBottom="@dimen/_14sdp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/ed_auth_scan_code"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="8"
                            android:paddingStart="@dimen/_16sdp"
                            android:paddingEnd="@dimen/_16sdp"
                            android:paddingTop="@dimen/_14sdp"
                            android:paddingBottom="@dimen/_14sdp"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/_18sdp"
                            android:textStyle="bold"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_auth_verify_code"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="Verify Code"
                        android:textAllCaps="false"
                        android:textSize="@dimen/_14sdp"
                        android:textColor="@color/white"
                        app:backgroundTint="@color/colorPrimaryDark"
                        app:cornerRadius="@dimen/_14sdp"
                        app:elevation="4dp"
                        app:icon="@drawable/ic_lock_lock"
                        app:iconGravity="textStart"
                        app:iconPadding="@dimen/_8sdp"
                        app:iconTint="@android:color/white"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Divider -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="@dimen/_20sdp">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/col_bg_dark_gray"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADDITIONAL CONNECTION METHODS"
                    android:textColor="@color/dull_secondary"
                    android:textSize="@dimen/_10sdp"
                    android:textStyle="bold"
                    android:paddingHorizontal="@dimen/_12sdp"/>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="@color/col_bg_dark_gray"/>

            </LinearLayout>

            <!-- Expounded Alternative Connection Options -->
            <!-- WiFi Direct Option -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/col_bg_dark_gray"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/col_bg_lite_gray"
                android:layout_marginBottom="@dimen/_12sdp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/_14sdp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="@color/colorPrimaryLight"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_set_as"
                            app:tint="@color/colorPrimaryDark"/>

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Wi-Fi Direct"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="High-speed peer-to-peer transfer over local Wi-Fi router or hotspot without requiring internet connectivity."
                            android:textColor="@color/dull_secondary"
                            android:textSize="@dimen/_11sdp"
                            android:layout_marginTop="@dimen/_2sdp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Bluetooth Option -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/_14sdp"
                app:cardElevation="0dp"
                app:strokeColor="@color/col_bg_dark_gray"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/col_bg_lite_gray">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="@dimen/_14sdp"
                    android:gravity="center_vertical">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        app:cardCornerRadius="20dp"
                        app:cardBackgroundColor="@color/colorPrimaryLight"
                        app:cardElevation="0dp"
                        android:layout_marginEnd="@dimen/_12sdp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_menu_set_as"
                            app:tint="@color/colorPrimaryDark"/>

                    </com.google.android.material.card.MaterialCardView>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bluetooth Pairing"
                            android:textColor="@color/colorPrimaryDark"
                            android:textSize="@dimen/_14sdp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Offline short-range connection for sharing text clips and small files when local network is unavailable."
                            android:textColor="@color/dull_secondary"
                            android:textSize="@dimen/_11sdp"
                            android:layout_marginTop="@dimen/_2sdp"/>

                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Server Configuration Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_auth_backend_config"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Configure Server URL"
                android:textAllCaps="false"
                android:textSize="@dimen/_13sdp"
                android:textColor="@color/colorPrimary"
                app:strokeColor="@color/colorPrimary"
                app:strokeWidth="1dp"
                app:cornerRadius="@dimen/_12sdp"
                android:layout_marginTop="@dimen/_16sdp"
                app:icon="@drawable/ic_settings_fill"
                app:iconGravity="textStart"
                app:iconPadding="@dimen/_8sdp"
                app:iconTint="@color/colorPrimary"/>

            <!-- Help Text -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Need help connecting? Visit our online help guide"
                android:textColor="@color/dull_secondary"
                android:textSize="@dimen/_11sdp"
                android:layout_marginTop="@dimen/_24sdp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
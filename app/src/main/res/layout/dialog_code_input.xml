<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/_20sdp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Enter the 8-digit code from the website"
        android:textColor="@color/dull_primary"
        android:textSize="@dimen/_14sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        android:gravity="center"/>

    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Connection Code"
        app:hintTextColor="@color/dull_secondary"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="@color/dull_accent"
        app:endIconMode="clear_text"
        app:endIconTint="@color/dull_secondary"
        app:boxCornerRadiusTopStart="@dimen/_8sdp"
        app:boxCornerRadiusTopEnd="@dimen/_8sdp"
        app:boxCornerRadiusBottomEnd="@dimen/_8sdp"
        app:boxCornerRadiusBottomStart="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_16sdp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_connection_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="number"
            android:maxLength="8"
            android:gravity="center"
            android:textSize="@dimen/_18sdp"
            android:textStyle="bold"
            android:textColor="@color/dull_primary"/>

    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Example: 1234-5678"
        android:textColor="@color/dull_secondary"
        android:textSize="@dimen/_12sdp"
        android:gravity="center"
        android:layout_marginBottom="@dimen/_24sdp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Don't have a code? "
            android:textColor="@color/dull_secondary"
            android:textSize="@dimen/_12sdp"/>

        <TextView
            android:id="@+id/tv_generate_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Generate one"
            android:textColor="@color/colorPrimary"
            android:textSize="@dimen/_12sdp"
            android:textStyle="bold"
            android:padding="@dimen/_4sdp"
            android:background="?android:attr/selectableItemBackground"/>

    </LinearLayout>

</LinearLayout>
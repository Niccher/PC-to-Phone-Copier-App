<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorSurface">



    <!-- Loading spinner (centered in remaining space) -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/spinner_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            app:indicatorColor="@color/colorPrimary" />

        <!-- Empty state layout -->
        <LinearLayout
            android:id="@+id/layout_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/_24sdp"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/_64sdp"
                android:layout_height="@dimen/_64sdp"
                android:src="@drawable/ic_file_upload"
                app:tint="@color/dull_secondary"
                android:layout_marginBottom="@dimen/_12sdp"
                android:contentDescription="Empty state" />

            <TextView
                android:id="@+id/txt_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No Files Uploaded Yet"
                android:textColor="@color/colorOnSurface"
                android:textSize="@dimen/_16sdp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_empty_state"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_6sdp"
                android:gravity="center"
                android:text="Files uploaded from your PC or browser will appear here in real-time."
                android:textColor="@color/dull_secondary"
                android:textSize="@dimen/_13sdp" />

        </LinearLayout>

        <!-- File list — starts immediately below the header -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycler_uploaded_files"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="@dimen/_8sdp"
            android:paddingBottom="80dp"
            android:visibility="gone" />

        <!-- Batch Action Buttons (Hidden by default) -->
        <LinearLayout
            android:id="@+id/layout_batch_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="@dimen/_16sdp"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="@dimen/_12sdp"
            android:clipToPadding="false"
            android:visibility="gone">

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fab_batch_download"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/_8sdp"
                android:text="Download"
                android:textColor="@color/white"
                app:backgroundTint="@color/dull_success"
                app:icon="@drawable/ic_download"
                app:iconTint="@color/white"
                app:elevation="8dp" />

            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
                android:id="@+id/fab_batch_delete"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_8sdp"
                android:text="Delete"
                android:textColor="@color/white"
                app:backgroundTint="@color/dull_error"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/white"
                app:elevation="8dp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.niccher.pctophonecopier">

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>

    <uses-sdk tools:overrideLibrary="com.google.zxing.client.android" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/app_logo"
        android:usesCleartextTraffic="true"
        android:label="@string/app_name_1"
        android:roundIcon="@mipmap/app_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.P2P_Copier_NoAction">

        <activity
            android:name=".activities.Handle_Text_2_Image"
            android:theme="@style/Theme.P2P_Copier_Action"
            android:exported="false" />

        <activity
            android:name=".activities.Handle_Texts"
            android:theme="@style/Theme.P2P_Copier_Action"
            android:exported="false" />

        <activity
            android:name=".activities.AuthSession"
            android:exported="false" />
        <!--
            <activity
            android:name=".activities.Regista"
            android:exported="false"
            android:label="@string/title_activity_regista"
            android:theme="@style/AppTheme2.NoActionBar" />
        -->
        <activity android:name=".activities.Regista" />
        <activity android:name=".splash.Splasher">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".Dope" />
        <activity android:name=".MainActivity" />
        <activity
            android:name="com.journeyapps.barcodescanner.CaptureActivity"
            android:screenOrientation="portrait"
            android:stateNotNeeded="true"
            tools:replace="android:screenOrientation" />

        <meta-data
            android:name="com.google.firebase.ml.vision.DEPENDENCIES"
            android:value="ocr" />
    </application>

</manifest>